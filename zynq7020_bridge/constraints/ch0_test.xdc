# ATK-DF7020 / Leader ZYNQ baseboard V3.9, J4 CH0 acceptance wiring.
# U18 is the board's 50 MHz PL oscillator.  RESET_N on J4-16/Y6 is deliberately
# absent from this first image and must remain physically disconnected.
set_property PACKAGE_PIN U18 [get_ports pl_clk]
set_property IOSTANDARD LVCMOS33 [get_ports pl_clk]
create_clock -period 20.000 -name pl_clk_50mhz [get_ports pl_clk]

set_property PACKAGE_PIN N16 [get_ports ext_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports ext_reset_n]
set_property PULLTYPE PULLUP [get_ports ext_reset_n]

set_property PACKAGE_PIN T5 [get_ports ch0_mosi]
set_property PACKAGE_PIN U7 [get_ports ch0_miso]
set_property PACKAGE_PIN V8 [get_ports ch0_cs_n]
set_property PACKAGE_PIN U8 [get_ports ch0_drdy]
set_property PACKAGE_PIN T9 [get_ports ch0_sclk]
set_property PACKAGE_PIN V6 [get_ports ch0_sync_out]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_mosi]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_miso]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_cs_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_drdy]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_sclk]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_sync_out]

# Conservative output edges for the initial 1 MHz flying-wire validation.
set_property DRIVE 8 [get_ports ch0_mosi]
set_property DRIVE 8 [get_ports ch0_cs_n]
set_property DRIVE 8 [get_ports ch0_sclk]
set_property DRIVE 8 [get_ports ch0_sync_out]
set_property SLEW SLOW [get_ports ch0_mosi]
set_property SLEW SLOW [get_ports ch0_cs_n]
set_property SLEW SLOW [get_ports ch0_sclk]
set_property SLEW SLOW [get_ports ch0_sync_out]

# DRDY is level-synchronized in PL.  ext_reset_n is an asynchronous reset input.
set_false_path -from [get_ports ch0_drdy] -to [get_cells -hier -filter {ASYNC_REG == TRUE}]
set_false_path -from [get_ports ext_reset_n]

create_debug_core ch0_ila ila
set_property ALL_PROBE_SAME_MU true [get_debug_cores ch0_ila]
set_property ALL_PROBE_SAME_MU_CNT 1 [get_debug_cores ch0_ila]
set_property C_ADV_TRIGGER true [get_debug_cores ch0_ila]
set_property C_DATA_DEPTH 4096 [get_debug_cores ch0_ila]
set_property C_EN_STRG_QUAL false [get_debug_cores ch0_ila]
set_property C_INPUT_PIPE_STAGES 0 [get_debug_cores ch0_ila]
set_property C_TRIGIN_EN false [get_debug_cores ch0_ila]
set_property C_TRIGOUT_EN false [get_debug_cores ch0_ila]
set_property port_width 1 [get_debug_ports ch0_ila/clk]
connect_debug_port ch0_ila/clk [get_nets [list clock_mgr/clk_out]]
set_property PROBE_TYPE DATA_AND_TRIGGER [get_debug_ports ch0_ila/probe0]
set_property port_width 412 [get_debug_ports ch0_ila/probe0]
connect_debug_port ch0_ila/probe0 [get_nets [list {bad_commit_reject_count[0]} {bad_commit_reject_count[10]} {bad_commit_reject_count[11]} {bad_commit_reject_count[12]} {bad_commit_reject_count[13]} {bad_commit_reject_count[14]} {bad_commit_reject_count[15]} {bad_commit_reject_count[16]} {bad_commit_reject_count[17]} {bad_commit_reject_count[18]} {bad_commit_reject_count[19]} {bad_commit_reject_count[1]} {bad_commit_reject_count[20]} {bad_commit_reject_count[21]} {bad_commit_reject_count[22]} {bad_commit_reject_count[23]} {bad_commit_reject_count[24]} {bad_commit_reject_count[25]} {bad_commit_reject_count[26]} {bad_commit_reject_count[27]} {bad_commit_reject_count[28]} {bad_commit_reject_count[29]} {bad_commit_reject_count[2]} {bad_commit_reject_count[30]} {bad_commit_reject_count[31]} {bad_commit_reject_count[3]} {bad_commit_reject_count[4]} {bad_commit_reject_count[5]} {bad_commit_reject_count[6]} {bad_commit_reject_count[7]} {bad_commit_reject_count[8]} {bad_commit_reject_count[9]} {commit_error_count[0]} {commit_error_count[10]} {commit_error_count[11]} {commit_error_count[12]} {commit_error_count[13]} {commit_error_count[14]} {commit_error_count[15]} {commit_error_count[16]} {commit_error_count[17]} {commit_error_count[18]} {commit_error_count[19]} {commit_error_count[1]} {commit_error_count[20]} {commit_error_count[21]} {commit_error_count[22]} {commit_error_count[23]} {commit_error_count[24]} {commit_error_count[25]} {commit_error_count[26]} {commit_error_count[27]} {commit_error_count[28]} {commit_error_count[29]} {commit_error_count[2]} {commit_error_count[30]} {commit_error_count[31]} {commit_error_count[3]} {commit_error_count[4]} {commit_error_count[5]} {commit_error_count[6]} {commit_error_count[7]} {commit_error_count[8]} {commit_error_count[9]} {commit_ok_count[0]} {commit_ok_count[10]} {commit_ok_count[11]} {commit_ok_count[12]} {commit_ok_count[13]} {commit_ok_count[14]} {commit_ok_count[15]} {commit_ok_count[16]} {commit_ok_count[17]} {commit_ok_co