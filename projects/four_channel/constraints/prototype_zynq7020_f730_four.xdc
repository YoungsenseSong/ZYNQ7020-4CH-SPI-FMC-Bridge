# MC008 four-channel prototype. CH0 and FMC use the reviewed MC006 mapping.
# CH1..CH3 connector/package balls remain intentionally unassigned until the
# board schematic freezes the additional nRF lanes; the build script stops
# before bitstream generation when any of these ports are unconstrained.
set_property PACKAGE_PIN U18 [get_ports pl_clk]
set_property IOSTANDARD LVCMOS33 [get_ports pl_clk]
create_clock -period 20.000 -name pl_clk_50mhz [get_ports pl_clk]
set_property PACKAGE_PIN N16 [get_ports ext_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports ext_reset_n]
set_property PULLTYPE PULLUP [get_ports ext_reset_n]

# CH0 nRF on reviewed J4 pins.
set_property PACKAGE_PIN T9 [get_ports ch0_sclk]
set_property PACKAGE_PIN T5 [get_ports ch0_mosi]
set_property PACKAGE_PIN U7 [get_ports ch0_miso]
set_property PACKAGE_PIN V8 [get_ports ch0_cs_n]
set_property PACKAGE_PIN U8 [get_ports ch0_drdy]
set_property PACKAGE_PIN V6 [get_ports ch0_sync_out]
set_property PACKAGE_PIN Y6 [get_ports ch0_reset_n]

# FMC AD[15:0] and control signals on the reviewed J3 mapping.
set_property PACKAGE_PIN U19 [get_ports {fmc_ad[0]}]
set_property PACKAGE_PIN N20 [get_ports {fmc_ad[1]}]
set_property PACKAGE_PIN M19 [get_ports {fmc_ad[2]}]
set_property PACKAGE_PIN M20 [get_ports {fmc_ad[3]}]
set_property PACKAGE_PIN U20 [get_ports {fmc_ad[4]}]
set_property PACKAGE_PIN T20 [get_ports {fmc_ad[5]}]
set_property PACKAGE_PIN N18 [get_ports {fmc_ad[6]}]
set_property PACKAGE_PIN P19 [get_ports {fmc_ad[7]}]
set_property PACKAGE_PIN N17 [get_ports {fmc_ad[8]}]
set_property PACKAGE_PIN P18 [get_ports {fmc_ad[9]}]
set_property PACKAGE_PIN V20 [get_ports {fmc_ad[10]}]
set_property PACKAGE_PIN W20 [get_ports {fmc_ad[11]}]
set_property PACKAGE_PIN R17 [get_ports {fmc_ad[12]}]
set_property PACKAGE_PIN R16 [get_ports {fmc_ad[13]}]
set_property PACKAGE_PIN W19 [get_ports {fmc_ad[14]}]
set_property PACKAGE_PIN W18 [get_ports {fmc_ad[15]}]
set_property PACKAGE_PIN P16 [get_ports fmc_nadv_n]
set_property PACKAGE_PIN P15 [get_ports fmc_ne1_n]
set_property PACKAGE_PIN Y19 [get_ports fmc_noe_n]
set_property PACKAGE_PIN Y18 [get_ports fmc_nwe_n]
set_property PACKAGE_PIN R18 [get_ports fmc_nwait_n]
set_property PACKAGE_PIN T17 [get_ports fpga_irq]
set_property PACKAGE_PIN V18 [get_ports status_led]

set_property IOSTANDARD LVCMOS33 [get_ports {fmc_ad[*]}]
set_property IOSTANDARD LVCMOS33 [get_ports fmc_nadv_n]
set_property IOSTANDARD LVCMOS33 [get_ports fmc_ne1_n]
set_property IOSTANDARD LVCMOS33 [get_ports fmc_noe_n]
set_property IOSTANDARD LVCMOS33 [get_ports fmc_nwe_n]
set_property IOSTANDARD LVCMOS33 [get_ports fmc_nwait_n]
set_property IOSTANDARD LVCMOS33 [get_ports fpga_irq]
set_property IOSTANDARD LVCMOS33 [get_ports status_led]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_sclk]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_mosi]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_miso]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_cs_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_drdy]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_sync_out]
set_property IOSTANDARD LVCMOS33 [get_ports ch0_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_sclk]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_mosi]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_miso]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_cs_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_drdy]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_sync_out]
set_property IOSTANDARD LVCMOS33 [get_ports ch1_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_sclk]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_mosi]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_miso]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_cs_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_drdy]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_sync_out]
set_property IOSTANDARD LVCMOS33 [get_ports ch2_reset_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_sclk]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_mosi]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_miso]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_cs_n]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_drdy]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_sync_out]
set_property IOSTANDARD LVCMOS33 [get_ports ch3_reset_n]
set_property DRIVE 8 [get_ports ch0_sclk]
set_property DRIVE 8 [get_ports ch0_mosi]
set_property DRIVE 8 [get_ports ch0_cs_n]
set_property DRIVE 8 [get_ports ch0_sync_out]
set_property DRIVE 8 [get_ports ch0_reset_n]
set_property SLEW SLOW [get_ports ch0_sclk]
set_property SLEW SLOW [get_ports ch0_mosi]
set_property SLEW SLOW [get_ports ch0_cs_n]
set_property SLEW SLOW [get_ports ch0_sync_out]
set_property SLEW SLOW [get_ports ch0_reset_n]
set_property PULLTYPE PULLUP [get_ports ch0_cs_n]
set_false_path -from [get_ports {ch0_drdy ch1_drdy ch2_drdy ch3_drdy ext_reset_n}]

create_debug_core prototype_ila ila
set_property ALL_PROBE_SAME_MU true [get_debug_cores prototype_ila]
set_property ALL_PROBE_SAME_MU_CNT 1 [get_debug_cores prototype_ila]
set_property C_ADV_TRIGGER true [get_debug_cores prototype_ila]
set_property C_DATA_DEPTH 4096 [get_debug_cores prototype_ila]
set_property C_EN_STRG_QUAL false [get_debug_cores prototype_ila]
set_property C_INPUT_PIPE_STAGES 0 [get_debug_cores prototype_ila]
set_property C_TRIGIN_EN false [get_debug_cores prototype_ila]
set_property C_TRIGOUT_EN false [get_debug_cores prototype_ila]
set_property port_width 1 [get_debug_ports prototype_ila/clk]
connect_debug_port prototype_ila/clk [get_nets [list pl_clk_IBUF_BUFG]]
set_property PROBE_TYPE DATA_AND_TRIGGER [get_debug_ports prototype_ila/probe0]
set_property port_width 288 [get_debug_ports prototype_ila/probe0]
connect_debug_port prototype_ila/probe0 [get_nets [list {ila_probe[0]} {ila_probe[100]} {ila_probe[101]} {ila_probe[102]} {ila_probe[103]} {ila_probe[104]} {ila_probe[105]} {ila_probe[106]} {ila_probe[107]} {ila_probe[108]} {ila_probe[109]} {ila_probe[10]} {ila_probe[110]} {ila_probe[111]} {ila_probe[112]} {ila_probe[113]} {ila_probe[114]} {ila_probe[115]} {ila_probe[116]} {ila_probe[117]} {ila_probe[118]} {ila_probe[119]} {ila_probe[11]} {ila_probe[120]} {ila_probe[121]} {ila_probe[122]} {ila_probe[123]} {ila_probe[124]} {ila_probe[125]} {ila_probe[126]} {ila_probe[127]} {ila_probe[128]} {ila_probe[129]} {ila_probe[12]} {ila_probe[130]} {ila_probe[131]} {ila_probe[132]} {ila_probe[133]} {ila_probe[134]} {ila_probe[135]} {ila_probe[136]} {ila_probe[137]} {ila_probe[138]} {ila_probe[139]} {ila_probe[13]} {ila_probe[140]} {ila_probe[141]} {ila_probe[142]} {ila_probe[143]} {ila_probe[144]} {ila_probe[145]} {ila_probe[146]} {ila_probe[147]} {ila_probe[148]} {ila_probe[149]} {ila_probe[14]} {ila_probe[150]} {ila_probe[151]} {ila_probe[152]} {ila_probe[153]} {ila_probe[154]} {ila_probe[155]} {ila_probe[156]} {ila_probe[157]} {ila_probe[158]} {ila_probe[159]} {ila_probe[15]} {ila_probe[160]} {ila_probe[161]} {ila_probe[162]} {ila_probe[163]} {ila_probe[164]} {ila_probe[165]} {ila_probe[166]} {ila_probe[167]} {ila_probe[168]} {ila_probe[169]} {ila_probe[16]} {ila_probe[170]} {ila_probe[171]} {ila_probe[172]} {ila_probe[173]} {ila_probe[174]} {ila_probe[175]} {ila_probe[176]} {ila_probe[177]} {ila_probe[178]} {ila_probe[179]} {ila_probe[17]} {ila_probe[180]} {ila_probe[181]} {ila_probe[182]} {ila_probe[183]} {ila_probe[184]} {ila_probe[185]} {ila_probe[186]} {ila_probe[187]} {ila_probe[188]} {ila_probe[189]} {ila_probe[18]} {ila_probe[190]} {ila_probe[191]} {ila_probe[192]} {ila_probe[193]} {ila_probe[194]} {ila_probe[195]} {ila_probe[196]} {ila_probe[197]} {ila_probe[198]} {ila_probe[199]} {ila_probe[19]} {ila_probe[1]} {ila_probe[200]} {ila_probe[201]} {ila_probe[202]} {il